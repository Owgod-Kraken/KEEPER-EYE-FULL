<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".ScanActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.keepereye.app.ocr.TextOverlayView
        android:id="@+id/textOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.keepereye.app.obstacle.ObjectOverlayView
        android:id="@+id/objectOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:contentDescription="@string/back"
        app:backgroundTint="@color/overlay_dark"
        app:icon="@drawable/ic_back"
        app:iconSize="28dp"
        app:iconTint="@color/text_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Mode indicator badge -->
    <TextView
        android:id="@+id/tvModeIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_rounded_dark"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/mode_ocr"
        android:textColor="@color/accent_green"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Mode toggle button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleMode"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:contentDescription="@string/toggle_mode"
        app:backgroundTint="@color/overlay_dark"
        app:icon="@drawable/ic_assist"
        app:iconSize="28dp"
        app:iconTint="@color/accent_orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvModeIndicator" />

    <!-- Status indicators -->
    <LinearLayout
        android:id="@+id/statusIndicators"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvNoText">

        <TextView
            android:id="@+id/tvTextStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_dark"
            android:drawablePadding="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/text_detected"
            android:textColor="@color/accent_green"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvObstacleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rounded_dark"
            android:drawablePadding="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/obstacle_detected"
            android:textColor="@color/accent_orange"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_dark"
        android:padding="16dp"
        android:text="@string/scanning"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.85" />

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/panel_dark"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvDetectedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_green"
                android:textSize="16sp"
                android:visibility="gone"
                tools:text="Texto detectado aquí"
                tools:visibility="visible" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRepeat"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/repeat"
                android:textColor="@color/background_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_green"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_replay"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconTint="@color/background_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/stop"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_red"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_stop"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconTint="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSpeedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Velocidad: 1.0x" />

            <SeekBar
                android:id="@+id/speedSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="33"
                android:progressTint="@color/accent_green"
                android:thumbTint="@color/accent_green" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
