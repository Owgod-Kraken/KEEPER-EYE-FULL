<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KeeperEye" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorPrimaryDark">@color/background_dark</item>
        <item name="colorAccent">@color/accent_violet</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_violet</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSurface">@color/panel_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="Theme.KeeperEye.Splash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
    </style>
</resources>
